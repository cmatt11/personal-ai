# Personal AI configuration. Copy to .env and source it, or export these vars.
# Everything has a sensible default; nothing here is required to start.

# --- Where local data is stored (SQLite db, workspace, notes) ---
# PERSONAL_AI_HOME=~/.personal_ai
# PERSONAL_AI_WORKSPACE=~/.personal_ai/workspace

# --- Which brain to use: auto (local first, then online), local, online, or hybrid ---
# hybrid = online when connected (fast/smart), local fallback when offline.
# PERSONAL_AI_BACKEND=auto

# --- Local model via Ollama (offline) ---
# OLLAMA_HOST=http://localhost:11434
# PERSONAL_AI_LOCAL_MODEL=llama3.2
# PERSONAL_AI_LOCAL_EMBED_MODEL=nomic-embed-text
# PERSONAL_AI_LOCAL_VISION_MODEL=llama3.2-vision   # for image analysis offline

# --- Online model (OpenAI-compatible API), optional ---
# PERSONAL_AI_ONLINE_API_KEY=sk-...
# OPENAI_API_KEY=sk-...                       # also accepted
# PERSONAL_AI_ONLINE_BASE_URL=https://api.openai.com/v1
# PERSONAL_AI_ONLINE_MODEL=gpt-4o-mini
# PERSONAL_AI_ONLINE_EMBED_MODEL=text-embedding-3-small
# PERSONAL_AI_ONLINE_VISION_MODEL=gpt-4o-mini      # for image analysis online

# --- Integrations (optional; each works once you add its credential) ---
# GITHUB_TOKEN=ghp_...                 # GitHub
# VERCEL_TOKEN=...                     # Vercel
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...   # Discord
# GOOGLE_ACCESS_TOKEN=ya29...          # Gmail, Drive, Docs, Meet (OAuth token)
# MS_GRAPH_TOKEN=...                   # Outlook, OneDrive, Word, Teams (Graph token)
# TWITTER_BEARER_TOKEN=...             # Twitter/X
# INSTAGRAM_ACCESS_TOKEN=...           # Instagram (Graph API)

# --- Behavior ---
# PERSONAL_AI_MAX_STEPS=8                  # max tool steps per reply
# PERSONAL_AI_HISTORY_TURNS=12             # recent messages kept in context
# PERSONAL_AI_MEMORY_TOP_K=4               # memories retrieved per turn
# PERSONAL_AI_CONTEXT_CHAR_BUDGET=12000    # context window budget (characters)
# PERSONAL_AI_CONSOLIDATE_EVERY=25         # auto-clean memory every N messages
# PERSONAL_AI_AUTO_REMEMBER=true           # auto-store conversation for recall
# PERSONAL_AI_ALLOW_WEB=true               # enable web search/fetch tools
# PERSONAL_AI_ALLOW_CODE=true              # enable the run_python tool
# PERSONAL_AI_ALLOW_SHELL=true             # enable the run_shell tool
# PERSONAL_AI_ALLOW_SELF_MODIFY=true       # let the AI add/remove its own tools
# PERSONAL_AI_REQUEST_TIMEOUT=120

# --- Optional encryption at rest (needs: pip install cryptography) ---
# PERSONAL_AI_PASSPHRASE=your-secret-passphrase   # encrypts message + memory text
